#!/bin/bash
# `omarchy plugin add` only clones files, so this installs the daemon: the
# prebuilt binary from the GitHub release matching manifest.json, or a cargo
# build when there is no release for this version or this machine.
#
#   ./setup                 download the release binary, or build if there is none
#   ./setup --from-source   always build with cargo
#
# ATRIUM_RELEASE_URL replaces the download base (normally
# https://github.com/bitshiftxr/atrium/releases/download/v<version>), which is
# how the download path is tested without a real release.

set -euo pipefail

root=$(cd "$(dirname "$0")" && pwd)
dest="$root/bin/atriumd"

say() { printf 'setup: %s\n' "$*"; }
warn() { printf 'setup: %s\n' "$*" >&2; }

usage() {
  sed -n '2,12s/^# \{0,1\}//p' "$0"
}

from_source=0
while (( $# > 0 )); do
  case "$1" in
  --from-source) from_source=1 ;;
  -h | --help) usage; exit 0 ;;
  *) warn "unknown option: $1"; usage >&2; exit 2 ;;
  esac
  shift
done

# Puts a finished binary in place with a rename, so the shell never starts a
# half-written file and a running daemon keeps its old inode.
install_binary() {
  mkdir -p "$root/bin" &&
    install -m 755 "$1" "$dest.new" &&
    mv -f "$dest.new" "$dest"
}

build_from_source() {
  if ! command -v cargo >/dev/null 2>&1; then
    omarchy pkg add rust
  fi

  # The shell watches the plugins directory with `inotifywait -r` and rescans on
  # every file event, so a build inside it reloads the shell thousands of times.
  # Everything is written to the cache; only the finished binary lands here.
  local target="${XDG_CACHE_HOME:-$HOME/.cache}/atrium/target"

  cargo build --release --locked --manifest-path "$root/daemon/Cargo.toml" --target-dir "$target"
  install_binary "$target/release/atriumd" || exit 1
  say "built atriumd from source."
}

target_triple() {
  case "$(uname -m)" in
  x86_64) echo x86_64-unknown-linux-gnu ;;
  aarch64 | arm64) echo aarch64-unknown-linux-gnu ;;
  *) return 1 ;;
  esac
}

fetch() {
  curl --fail --silent --show-error --location \
    --proto '=https,file' --proto-redir '=https' \
    --connect-timeout 10 --max-time 300 --retry 2 \
    --output "$2" "$1"
}

# Downloads go to a temp directory outside the plugin folder, for the same
# reason the build does.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# Runs with errexit off, since it is called as `install_release || ...`, so
# every step that matters is checked by hand.
#
# Returns 0 once bin/atriumd is the release binary, 1 when there is no usable
# release (so the caller builds instead), and 3 when a download did not match
# its checksum (so the caller builds instead, and says so loudly).
install_release() {
  local version triple asset base expected actual
  version=$(jq -r '.version // empty' "$root/manifest.json")
  [[ -n $version ]] || { warn "manifest.json has no version."; return 1; }

  if ! triple=$(target_triple); then
    warn "no prebuilt atriumd for $(uname -m)."
    return 1
  fi
  asset="atriumd-$triple"
  base="${ATRIUM_RELEASE_URL:-https://github.com/bitshiftxr/atrium/releases/download/v$version}"

  if ! fetch "$base/SHA256SUMS" "$work/SHA256SUMS"; then
    warn "no release found for v$version at $base."
    return 1
  fi
  expected=$(awk -v f="$asset" '$2 == f || $2 == "*" f { print $1; exit }' "$work/SHA256SUMS")
  if [[ ! $expected =~ ^[0-9a-f]{64}$ ]]; then
    warn "the v$version release has no checksum for $asset."
    return 1
  fi

  if [[ -x $dest ]] && [[ $(sha256sum "$dest" | cut -d' ' -f1) == "$expected" ]]; then
    say "atriumd v$version is already installed."
    return 0
  fi

  say "downloading atriumd v$version for $triple..."
  if ! fetch "$base/$asset" "$work/$asset"; then
    warn "could not download $asset from the v$version release."
    return 1
  fi

  actual=$(sha256sum "$work/$asset" | cut -d' ' -f1)
  if [[ $actual != "$expected" ]]; then
    warn ""
    warn "CHECKSUM MISMATCH for $asset — refusing to install it."
    warn "  expected $expected"
    warn "  got      $actual"
    warn "The download is corrupt or has been tampered with."
    warn ""
    return 3
  fi

  install_binary "$work/$asset" || exit 1
  say "installed atriumd v$version."
}

if (( from_source )); then
  build_from_source
else
  status=0
  install_release || status=$?
  if (( status != 0 )); then
    if (( status == 3 )); then
      warn "building from source instead of using the release binary."
    else
      say "building from source instead."
    fi
    build_from_source
  fi
fi

echo
echo "Next: open the panel and paste your Home Assistant URL and a long-lived"
echo "access token (Home Assistant -> your profile -> Security)."
echo
echo "When the panel opens, your rooms appear immediately as configured in your"
echo "Home Assistant dashboard."
