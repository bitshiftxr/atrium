# The atriumd release the panel runs. bin/atriumd-launcher downloads this
# asset for the machine's architecture and refuses it unless its size and
# SHA256 match. The Release workflow opens a pull request that updates this
# file once a release's assets are published; do not point it at a tag whose
# assets do not exist yet. CI checks that it resolves.
ATRIUMD_TAG=v0.1.0
ATRIUMD_X86_64_ASSET=atriumd-x86_64-unknown-linux-gnu
ATRIUMD_X86_64_SIZE=3419680
ATRIUMD_X86_64_SHA256=cb09e0c00aa720245c0a3209c2eb8cb7c349d8a625d8caa40bea739cb1d10527
ATRIUMD_AARCH64_ASSET=atriumd-aarch64-unknown-linux-gnu
ATRIUMD_AARCH64_SIZE=3019848
ATRIUMD_AARCH64_SHA256=510c5c5042c38f7837264d32c9ad7c85245426b128ea72238aade9fcd740f0a5
